# Salin jadi .env (lokal) atau isi sebagai Environment Variables di Vercel.
# Jangan pernah commit nilai aslinya.

# Supabase - Transaction Pooler (port 6543) untuk aplikasi
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase - Session Pooler (port 5432) untuk prisma db push / seed
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Kunci tanda tangan cookie login (WAJIB di produksi, minimal 32 karakter acak)
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""

# Opsional: ukuran pool koneksi database (default 3 di Vercel, 10 di lokal)
# DB_POOL_MAX=3
