datasource db {
  provider = "postgresql"
  schemas  = ["personal_finance"]
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  pin       String   
  role      String   @default("admin") 
  failedAttempts Int       @default(0) @map("failed_attempts") // salah PIN berturut-turut
  lockedUntil    DateTime? @map("locked_until") // dikunci sementara setelah terlalu banyak salah
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
  @@schema("personal_finance")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  type      String   // "income" | "expense" | "inventory"
  parentId  String?  @map("parent_id")
  parent    Category?  @relation("CategorySelf", fields: [parentId], references: [id], onDelete: Cascade)
  children  Category[] @relation("CategorySelf")
  
  transactions     Transaction[] @relation("CategoryTransactions")
  subTransactions  Transaction[] @relation("SubCategoryTransactions")
  fixedCosts       FixedCost[]   @relation("CategoryFixedCosts")
  subFixedCosts    FixedCost[]   @relation("SubCategoryFixedCosts")
  inventories      Inventory[]
  subscriptions    Subscription[]
  budgets          Budget[]
  installments     Installment[]
  ecommerceTxns    EcommerceTransaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("categories")
  @@schema("personal_finance")
}

model Bank {
  id             String   @id @default(uuid())
  name           String
  accountNumber  String   @map("account_number")
  initialBalance Decimal  @map("initial_balance") @db.Decimal(15, 2)
  accountType    String   @map("account_type") // "bank" | "ewallet" | "emoney" | "paylater" | "credit_card" | "cash"
  walletName     String   @default("Pribadi") @map("wallet_name") // dompet/buku: Pribadi, Kontrakan, dll
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  transactions     Transaction[]
  deposits         Deposit[]
  ecommerceTxns    EcommerceTransaction[]
  subscriptions    Subscription[]
  installments     Installment[]

  @@map("banks")
  @@schema("personal_finance")
}

model Transaction {
  id             String   @id @default(uuid())
  type           String   // "income" | "expense" | "transfer"
  categoryId     String   @map("category_id")
  category       Category @relation("CategoryTransactions", fields: [categoryId], references: [id])
  subCategoryId  String?  @map("sub_category_id")
  subCategory    Category? @relation("SubCategoryTransactions", fields: [subCategoryId], references: [id])
  amount         Decimal  @db.Decimal(15, 2)
  date           DateTime @db.Date
  description    String?
  bankId         String   @map("bank_id")
  bank           Bank     @relation(fields: [bankId], references: [id], onDelete: Cascade)
  discount       Decimal  @default(0) @db.Decimal(15, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  ecommerceTxn   EcommerceTransaction?
  installmentPayment InstallmentPayment?

  @@map("transactions")
  @@schema("personal_finance")
}

model FixedCost {
  id             String   @id @default(uuid())
  name           String
  amount         Decimal  @db.Decimal(15, 2)
  categoryId     String   @map("category_id")
  category       Category @relation("CategoryFixedCosts", fields: [categoryId], references: [id])
  subCategoryId  String?  @map("sub_category_id")
  subCategory    Category? @relation("SubCategoryFixedCosts", fields: [subCategoryId], references: [id])
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("fixed_costs")
  @@schema("personal_finance")
}

model Deposit {
  id           String   @id @default(uuid())
  name         String
  bankId       String   @map("bank_id")
  bank         Bank     @relation(fields: [bankId], references: [id], onDelete: Cascade)
  amount       Decimal  @db.Decimal(15, 2)
  rate         Decimal  @db.Decimal(5, 2) 
  tenor        Int      
  startDate    DateTime @map("start_date") @db.Date
  maturityDate DateTime @map("maturity_date") @db.Date
  status       String   @default("active") 
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("deposits")
  @@schema("personal_finance")
}

model Crypto {
  id        String   @id @default(uuid())
  name      String   
  quantity  Decimal  @db.Decimal(18, 8)
  valueIdr  Decimal  @map("value_idr") @db.Decimal(15, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cryptos")
  @@schema("personal_finance")
}

model EcommercePlatform {
  id        String   @id @default(uuid())
  platform  String   
  storeName String?  @map("store_name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transactions EcommerceTransaction[]

  @@map("ecommerce_platforms")
  @@schema("personal_finance")
}

model EcommerceTransaction {
  id           String            @id @default(uuid())
  date         DateTime          @db.Date
  platformId   String            @map("platform_id")
  platform     EcommercePlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  itemName     String            @map("item_name")
  categoryId   String            @map("category_id")
  category     Category          @relation(fields: [categoryId], references: [id])
  amount       Decimal           @db.Decimal(15, 2)
  bankId       String            @map("bank_id")
  bank         Bank              @relation(fields: [bankId], references: [id])
  tenor        Int               @default(1) 
  txnId        String?           @unique @map("txn_id")
  transaction  Transaction?      @relation(fields: [txnId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  inventories  Inventory[]

  @@map("ecommerce_transactions")
  @@schema("personal_finance")
}

model Inventory {
  id             String               @id @default(uuid())
  itemName       String               @map("item_name")
  categoryId     String               @map("category_id")
  category       Category             @relation(fields: [categoryId], references: [id])
  purchasePrice  Decimal              @map("purchase_price") @db.Decimal(15, 2)
  purchaseDate   DateTime             @map("purchase_date") @db.Date
  lifespanMonths Int                  @map("lifespan_months") @default(24)
  condition      String               @default("Baik") 
  source         String               @default("manual") 
  ecomId         String?              @map("ecom_id")
  ecommerceTxn   EcommerceTransaction? @relation(fields: [ecomId], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@map("inventory")
  @@schema("personal_finance")
}

model Subscription {
  id           String   @id @default(uuid())
  name         String
  email        String?
  amount       Decimal  @db.Decimal(15, 2)
  billingCycle String   @map("billing_cycle") 
  dueDate      DateTime @map("due_date") @db.Date
  categoryId   String   @map("category_id")
  category     Category @relation(fields: [categoryId], references: [id])
  bankId       String   @map("bank_id")
  bank         Bank     @relation(fields: [bankId], references: [id])
  status       String   @default("active") 
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("subscriptions")
  @@schema("personal_finance")
}

model Budget {
  id         String   @id @default(uuid())
  month      String   
  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  limit      Decimal  @db.Decimal(15, 2)
  note       String?  // catatan bebas, misal "KPR BTN s/d 2040"
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([month, categoryId])
  @@map("budgets")
  @@schema("personal_finance")
}

// Cicilan / hutang berjangka (KPR, kendaraan, pinjaman, dll)
model Installment {
  id               String   @id @default(uuid())
  name             String
  lender           String?  // pemberi pinjaman, misal "BTN"
  monthlyAmount    Decimal  @map("monthly_amount") @db.Decimal(15, 2)
  tenorMonths      Int      @map("tenor_months")
  startDate        DateTime @map("start_date") @db.Date // jatuh tempo cicilan pertama
  initialPaidCount Int      @default(0) @map("initial_paid_count") // sudah dibayar sebelum dicatat di aplikasi
  categoryId       String   @map("category_id")
  category         Category @relation(fields: [categoryId], references: [id])
  bankId           String   @map("bank_id")
  bank             Bank     @relation(fields: [bankId], references: [id])
  note             String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  payments InstallmentPayment[]

  @@map("installments")
  @@schema("personal_finance")
}

// Pembayaran cicilan; selalu terhubung ke transaksi pengeluaran
model InstallmentPayment {
  id            String      @id @default(uuid())
  installmentId String      @map("installment_id")
  installment   Installment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  transactionId String      @unique @map("transaction_id")
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  periodNumber  Int         @map("period_number") // cicilan ke-berapa
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("installment_payments")
  @@schema("personal_finance")
}

// Pos alokasi (amplop virtual): pembagian sisa gaji, uang tetap di rekening
model Pocket {
  id           String   @id @default(uuid())
  name         String
  percent      Decimal  @default(0) @db.Decimal(5, 2) // % dari sisa bulanan
  targetAmount Decimal? @map("target_amount") @db.Decimal(15, 2)
  note         String?
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  entries PocketEntry[]

  @@map("pockets")
  @@schema("personal_finance")
}

// Mutasi saldo pos: alokasi (+), isi manual (+), pakai (-)
model PocketEntry {
  id        String   @id @default(uuid())
  pocketId  String   @map("pocket_id")
  pocket    Pocket   @relation(fields: [pocketId], references: [id], onDelete: Cascade)
  type      String   // "allocate" | "deposit" | "withdraw"
  amount    Decimal  @db.Decimal(15, 2) // bertanda: + masuk, - keluar
  month     String?  // YYYY-MM, untuk alokasi sisa bulanan
  date      DateTime @db.Date
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([pocketId])
  @@map("pocket_entries")
  @@schema("personal_finance")
}

// Pengaturan aplikasi (key-value), misal rencana pemasukan untuk proyeksi tahunan
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
  @@schema("personal_finance")
}
